# Public — safe to embed in the Expo client (never put service-role or AI keys here)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Used to build shareable invite links on native (web can use window.location.origin).
EXPO_PUBLIC_WEB_URL=http://localhost:5300

# Public — safe to embed in the Expo client (never put service-role or AI keys here)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Used to build shareable invite links on native (web can use window.location.origin).
EXPO_PUBLIC_WEB_URL=http://localhost:5300

# Meals API (scrape + AI). Local: http://localhost:5301. Production web: leave empty (same origin).
EXPO_PUBLIC_API_URL=http://localhost:5301

# Web-only mobile layout preview. Leave unset in production / Vercel builds.
# Copy the EXPO_PUBLIC_* keys into apps/kinexus/.env for Expo to pick them up.
EXPO_PUBLIC_ENABLE_MOBILE_PREVIEW=1

# Server-only keys live in packages/api/.env (local) or Vercel env (prod) — never in the Expo client env.
# AI_PROVIDER=anthropic|deepseek
# ANTHROPIC_API_KEY / DEEPSEEK_API_KEY
# SUPABASE_URL / SUPABASE_ANON_KEY (same project as the app; used to verify JWTs)
# SUPABASE_SERVICE_ROLE_KEY (server only — monthly recipe cost refresh + on-demand estimates)
# CRON_SECRET (Vercel Cron Authorization bearer for /api/prices/refresh)
# CORS_ORIGIN=http://localhost:5300,https://<prod-domain>
# TMDB_API_KEY (Lists → Watchlist; https://www.themoviedb.org/settings/api)
# RESIDENTIAL_PROXY_URL / RESIDENTIAL_PROXY_KEY (Stashd home Pi scrape proxy)
# PLAYWRIGHT_ENABLED=1 to force Playwright on Vercel (not recommended)


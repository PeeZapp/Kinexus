# Public — safe to embed in the Expo client (never put service-role or AI keys here)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Web-only mobile layout preview. Leave unset in production builds.
# Copy the EXPO_PUBLIC_* keys into apps/kinexus/.env for Expo to pick them up.
EXPO_PUBLIC_ENABLE_MOBILE_PREVIEW=1

# Server only — API / Vercel (Phase 5). Never expose to the client bundle.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
SUPABASE_SERVICE_ROLE_KEY=

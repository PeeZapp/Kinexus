{
  "expo": {
    "name": "Kinexus",
    "slug": "kinexus",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kinexus",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.peezapp.kinexus"
    },
    "android": {
      "package": "com.peezapp.kinexus",
      "adaptiveIcon": {
        "backgroundColor": "#0B1016",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "name": "Kinexus",
      "shortName": "Kinexus",
      "description": "One suite for meals, lists, money, nutrition, and training.",
      "lang": "en",
      "themeColor": "#0B1016",
      "backgroundColor": "#0B1016",
      "display": "standalone"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0B1016"
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}

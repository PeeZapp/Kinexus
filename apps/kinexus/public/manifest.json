{
  "id": "/",
  "name": "Kinexus",
  "short_name": "Kinexus",
  "description": "One suite for meals, lists, money, nutrition, and training.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0B1016",
  "theme_color": "#0B1016",
  "lang": "en",
  "dir": "ltr",
  "categories": ["lifestyle", "food", "finance"],
  "prefer_related_applications": false,
  "share_target": {
    "action": "/share/recipe",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "image/*",
            "image/jpeg",
            "image/png",
            "image/heic",
            "image/heif",
            "image/webp",
            ".jpg",
            ".jpeg",
            ".png",
            ".heic",
            ".heif",
            ".webp",
            "text/csv",
            "text/plain",
            "text/tab-separated-values",
            "application/json",
            "application/zip",
            "application/x-ofx",
            "application/vnd.intu.qfx",
            "application/x-qif",
            "application/vnd.intu.qbo",
            "application/pdf",
            "application/vnd.ms-excel",
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
            "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
            ".csv",
            ".tsv",
            ".txt",
            ".json",
            ".zip",
            ".ofx",
            ".qfx",
            ".qif",
            ".qbo",
            ".pdf",
            ".xls",
            ".xlsx",
            ".docx"
          ]
        }
      ]
    }
  },
  "icons": [
    {
      "src": "/icon-192.png",
      "type": "image/png",
      "sizes": "192x192",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "type": "image/png",
      "sizes": "512x512",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-512.png",
      "type": "image/png",
      "sizes": "512x512",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Import recipe",
      "short_name": "Import",
      "description": "Paste a recipe or video link",
      "url": "/import",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "My Recipes",
      "short_name": "Recipes",
      "description": "Saved recipe imports",
      "url": "/recipes",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}

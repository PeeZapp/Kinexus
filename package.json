{
  "name": "kinexus",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "concurrently -n api,app -c cyan,magenta \"pnpm --filter @kinexus/api dev\" \"pnpm --filter @kinexus/app start\"",
    "web": "concurrently -n api,app -c cyan,magenta \"pnpm --filter @kinexus/api dev\" \"pnpm --filter @kinexus/app web\"",
    "android": "pnpm --filter @kinexus/app android",
    "ios": "pnpm --filter @kinexus/app ios",
    "api": "pnpm --filter @kinexus/api dev",
    "api:build": "node scripts/build-api.mjs",
    "web:export": "pnpm --filter @kinexus/app web:export",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @kinexus/domain test && pnpm --filter @kinexus/api test",
    "db:push": "pnpm --filter @kinexus/db db:push",
    "db:link": "pnpm --filter @kinexus/db db:link"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "esbuild": "^0.25.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}

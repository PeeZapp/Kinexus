# Server only. Do not copy these into apps/kinexus/.env.

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
# Used by the monthly recipe-cost cron and on-demand estimates. Never put this in apps/kinexus/.env.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# Vercel Cron sends this as Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=

AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-haiku-4-5

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

API_PORT=5301
# Comma-separated browser origins. Vercel also allows VERCEL_URL automatically.
CORS_ORIGIN=http://localhost:5300

# Optional. LEGO set lookup uses BrickEconomy HTML by default; this key uses their official API when present.
BRICKECONOMY_API_KEY=
# Optional. Trading-card search uses PriceCharting HTML by default; Legendary API token uses their official API.
PRICECHARTING_TOKEN=
# Optional. Vinyl search uses the public Discogs API; a token raises the rate limit.
DISCOGS_TOKEN=
# Required for Lists → Watchlist search and where-to-watch. Free key: https://www.themoviedb.org/settings/api
TMDB_API_KEY=
# Optional. v4 read access token can be used instead of (or with) TMDB_API_KEY.
TMDB_ACCESS_TOKEN=

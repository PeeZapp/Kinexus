{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install",
  "buildCommand": "pnpm api:build && pnpm --filter @kinexus/app exec expo export --platform web",
  "outputDirectory": "apps/kinexus/dist",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/kinexus-trolley.zip",
      "headers": [
        { "key": "Content-Type", "value": "application/zip" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"kinexus-trolley.zip\"" },
        { "key": "Cache-Control", "value": "public, max-age=300" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/health", "destination": "/api?__path=/health" },
    { "source": "/scrape", "destination": "/api?__path=/scrape" },
    { "source": "/scrape-product", "destination": "/api?__path=/scrape-product" },
    { "source": "/scrape-link", "destination": "/api?__path=/scrape-link" },
    { "source": "/scrape-reader", "destination": "/api?__path=/scrape-reader" },
    { "source": "/archive-frame", "destination": "/api?__path=/archive-frame" },
    { "source": "/ai/mcp", "destination": "/api?__path=/ai/mcp" },
    { "source": "/ai/status", "destination": "/api?__path=/ai/status" },
    { "source": "/ai/keys/:path*", "destination": "/api?__path=/ai/keys/:path*" },
    { "source": "/ai/keys", "destination": "/api?__path=/ai/keys" },
    { "source": "/ai", "destination": "/api?__path=/ai" },
    { "source": "/prices/estimate", "destination": "/api?__path=/prices/estimate" },
    { "source": "/prices/refresh", "destination": "/api?__path=/prices/refresh" },
    { "source": "/stash/enrich", "destination": "/api?__path=/stash/enrich" },
    { "source": "/quotes/:path*", "destination": "/api?__path=/quotes/:path*" },
    { "source": "/quotes", "destination": "/api?__path=/quotes" },
    { "source": "/collectibles/search", "destination": "/api?__path=/collectibles/search" },
    { "source": "/collectibles/lookup", "destination": "/api?__path=/collectibles/lookup" },
    { "source": "/budget/classify", "destination": "/api?__path=/budget/classify" },
    { "source": "/budget/transactions/read", "destination": "/api?__path=/budget/transactions/read" },
    { "source": "/watchlist/search", "destination": "/api?__path=/watchlist/search" },
    { "source": "/watchlist/lookup", "destination": "/api?__path=/watchlist/lookup" },
    { "source": "/watchlist/resolve", "destination": "/api?__path=/watchlist/resolve" },
    { "source": "/watchlist/services", "destination": "/api?__path=/watchlist/services" },
    { "source": "/watchlist/recommend", "destination": "/api?__path=/watchlist/recommend" },
    { "source": "/watchlist/discover", "destination": "/api?__path=/watchlist/discover" },
    { "source": "/watchlist/people", "destination": "/api?__path=/watchlist/people" },
    { "source": "/watchlist/person", "destination": "/api?__path=/watchlist/person" },
    { "source": "/watchlist/cast", "destination": "/api?__path=/watchlist/cast" },
    { "source": "/watchlist/import/:path*", "destination": "/api?__path=/watchlist/import/:path*" },
    { "source": "/overview/places", "destination": "/api?__path=/overview/places" },
    { "source": "/overview/weather", "destination": "/api?__path=/overview/weather" },
    { "source": "/overview/news", "destination": "/api?__path=/overview/news" },
    { "source": "/overview/wordle", "destination": "/api?__path=/overview/wordle" },
    { "source": "/calendar/observances", "destination": "/api?__path=/calendar/observances" },
    { "source": "/profile/avatar/google/intent", "destination": "/api?__path=/profile/avatar/google/intent" },
    { "source": "/profile/avatar/google/complete", "destination": "/api?__path=/profile/avatar/google/complete" },
    { "source": "/profile/avatar/facebook/intent", "destination": "/api?__path=/profile/avatar/facebook/intent" },
    { "source": "/profile/avatar/facebook/complete", "destination": "/api?__path=/profile/avatar/facebook/complete" },
    { "source": "/profile/avatar/facebook/picture", "destination": "/api?__path=/profile/avatar/facebook/picture" },
    { "source": "/calendar/google/connect", "destination": "/api?__path=/calendar/google/connect" },
    { "source": "/calendar/google/callback", "destination": "/api?__path=/calendar/google/callback" },
    { "source": "/calendar/google/status", "destination": "/api?__path=/calendar/google/status" },
    { "source": "/calendar/google/calendars", "destination": "/api?__path=/calendar/google/calendars" },
    { "source": "/calendar/google/settings", "destination": "/api?__path=/calendar/google/settings" },
    { "source": "/calendar/google/disconnect", "destination": "/api?__path=/calendar/google/disconnect" },
    { "source": "/calendar/google/push", "destination": "/api?__path=/calendar/google/push" },
    { "source": "/calendar/google/delete", "destination": "/api?__path=/calendar/google/delete" },
    { "source": "/calendar/google/personal", "destination": "/api?__path=/calendar/google/personal" },
    { "source": "/mcp", "destination": "/api?__path=/mcp" },
    { "source": "/mcp/connections", "destination": "/api?__path=/mcp/connections" },
    { "source": "/mcp/connections/:id", "destination": "/api?__path=/mcp/connections/:id" },
    { "source": "/.well-known/oauth-protected-resource", "destination": "/api?__path=/.well-known/oauth-protected-resource" },
    { "source": "/.well-known/oauth-protected-resource/ai/mcp", "destination": "/api?__path=/.well-known/oauth-protected-resource/ai/mcp" },
    { "source": "/.well-known/oauth-authorization-server", "destination": "/api?__path=/.well-known/oauth-authorization-server" },
    { "source": "/grocery/compare", "destination": "/api?__path=/grocery/compare" },
    { "source": "/grocery/catalog", "destination": "/api?__path=/grocery/catalog" },
    { "source": "/grocery/catalogue/select", "destination": "/api?__path=/grocery/catalogue/select" },
    { "source": "/grocery/catalogue/refresh", "destination": "/api?__path=/grocery/catalogue/refresh" },
    { "source": "/grocery/connectors", "destination": "/api?__path=/grocery/connectors" },
    { "source": "/grocery/connectors/revoke", "destination": "/api?__path=/grocery/connectors/revoke" },
    { "source": "/grocery/handoff", "destination": "/api?__path=/grocery/handoff" },
    { "source": "/books/:path*", "destination": "/api?__path=/books/:path*" },
    { "source": "/readlist/:path*", "destination": "/api?__path=/readlist/:path*" },
    { "source": "/lists/import/:path*", "destination": "/api?__path=/lists/import/:path*" },
    { "source": "/train/import/:path*", "destination": "/api?__path=/train/import/:path*" },
    { "source": "/creators/verify-links", "destination": "/api?__path=/creators/verify-links" },
    { "source": "/api/(.*)", "destination": "/api?__path=/api/$1" },
    { "source": "/invite/train/:token", "destination": "/invite/train/[token]" },
    { "source": "/invite/:token", "destination": "/invite/[token]" },
    { "source": "/share/list/:token", "destination": "/share/list/[token]" },
    { "source": "/share/workout/:token", "destination": "/share/workout/[token]" },
    { "source": "/share/plan/:token", "destination": "/share/plan/[token]" },
    { "source": "/share/watchlist/:token", "destination": "/share/watchlist/[token]" },
    { "source": "/share/readlist/:token", "destination": "/share/readlist/[token]" },
    { "source": "/share/recipe", "destination": "/share/recipe" },
    { "source": "/share/trolley", "destination": "/share/trolley" },
    { "source": "/creators/search", "destination": "/api?__path=/creators/search" },
    { "source": "/me/profile-meta", "destination": "/api?__path=/me/profile-meta" },
    { "source": "/u/:key/report", "destination": "/api?__path=/u/:key/report" },
    { "source": "/u/:key/block", "destination": "/api?__path=/u/:key/block" },
    { "source": "/u/:key", "destination": "/u/[key]" },
    { "source": "/stash/shared/:token", "destination": "/api?__path=/stash/shared/:token" },
    { "source": "/train/shared/:token", "destination": "/api?__path=/train/shared/:token" },
    { "source": "/train/shared-plan/:token", "destination": "/api?__path=/train/shared-plan/:token" },
    { "source": "/watchlist/shared/:token", "destination": "/api?__path=/watchlist/shared/:token" },
    { "source": "/import", "destination": "/import" },
    { "source": "/meals/recipes/:id", "destination": "/meals/recipes/[id]" },
    { "source": "/recipes/mirror-image", "destination": "/api?__path=/recipes/mirror-image" },
    { "source": "/recipes/:id", "destination": "/recipes/[id]" },
    { "source": "/recipes", "destination": "/recipes" },
    { "source": "/http/:path*", "destination": "/http/[...slug]" },
    { "source": "/https/:path*", "destination": "/https/[...slug]" }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 180
    }
  },
  "crons": [
    {
      "path": "/api/prices/refresh",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/stash/enrich",
      "schedule": "0 19 * * *"
    },
    {
      "path": "/api/grocery/catalogue/select",
      "schedule": "30 16 * * 0"
    },
    {
      "path": "/api/grocery/catalogue/refresh",
      "schedule": "0 17 * * *"
    },
    {
      "path": "/api/grocery/catalogue/refresh",
      "schedule": "20 17 * * *"
    },
    {
      "path": "/api/grocery/catalogue/refresh",
      "schedule": "40 17 * * *"
    },
    {
      "path": "/api/grocery/catalogue/refresh",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/grocery/catalogue/refresh",
      "schedule": "20 18 * * *"
    },
    {
      "path": "/api/grocery/catalogue/refresh",
      "schedule": "40 18 * * *"
    }
  ]
}

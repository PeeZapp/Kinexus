{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install",
  "buildCommand": "pnpm --filter @kinexus/app exec expo export --platform web",
  "outputDirectory": "apps/kinexus/dist",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/health", "destination": "/api/health" },
    { "source": "/scrape", "destination": "/api/scrape" },
    { "source": "/ai", "destination": "/api/ai" },
    { "source": "/prices/estimate", "destination": "/api/prices/estimate" },
    { "source": "/prices/refresh", "destination": "/api/prices/refresh" },
    { "source": "/quotes", "destination": "/api/quotes" },
    { "source": "/collectibles/search", "destination": "/api/collectibles/search" },
    { "source": "/collectibles/lookup", "destination": "/api/collectibles/lookup" },
    { "source": "/budget/classify", "destination": "/api/budget/classify" },
    { "source": "/watchlist/search", "destination": "/api/watchlist/search" },
    { "source": "/watchlist/lookup", "destination": "/api/watchlist/lookup" },
    { "source": "/watchlist/resolve", "destination": "/api/watchlist/resolve" },
    { "source": "/invite/:token", "destination": "/index.html" },
    { "source": "/import", "destination": "/index.html" },
    { "source": "/meals/recipes/:id", "destination": "/index.html" },
    { "source": "/recipes/:id", "destination": "/index.html" },
    { "source": "/recipes", "destination": "/index.html" },
    { "source": "/http/:path*", "destination": "/index.html" },
    { "source": "/https/:path*", "destination": "/index.html" }
  ],
  "functions": {
    "api/[[...route]].ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/prices/refresh",
      "schedule": "0 6 * * *"
    }
  ]
}
